# Copy to .env and fill in. Never commit .env. (vaos-mvp/01 prerequisite)

# --- Telegram (interface, ADR-0003) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWLIST=
# Subset of the allowlist permitted to approve Actions (Phase 2, ADR-0008)
TELEGRAM_APPROVERS=

# --- LLM (modular port; Azure is the default adapter, ADR-0007) ---
LLM_PROVIDER=azure_openai          # azure_openai | anthropic | stub
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Anthropic Claude (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8    # or claude-sonnet-4-6 (cheaper) / claude-haiku-4-5

# --- Embeddings (local, on-prem, ADR-0007) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- Retrieval ---
INTERNAL_SOURCE=empty              # empty | faiss (FAISS over the vault; needs [rag] + built index)
PASAL_ID_BASE_URL=                 # regulation source (ADR-0002)
VAULT_PATH=./vault                 # Obsidian internal-knowledge vault
FAISS_INDEX_PATH=./data/index/vault.faiss

# --- Web search (strategy/opportunity only, ADR / never compliance) ---
TAVILY_API_KEY=
# Comma-separated watched-source domains. Tavily is asked for these only, and the
# proactive agents record them as the sources a sweep was drawn from.
# Leave empty to sweep the open web.
WEB_SOURCE_DOMAINS=anindya.biz,*.anindya.biz,scisi.co.id,*.scisi.co.id

# --- Persistence (Feedback Loop, vaos-mvp/09) ---
DATABASE_URL=postgresql+psycopg://localhost/vaos

# --- Execution (Phase 2, ADR-0008) ---
LINEAR_API_KEY=
